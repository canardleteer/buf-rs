# Alpine sibling of Dockerfile. Same COPY / ENTRYPOINT / cargo fetch.
# Do not COPY path-src (same main-workflow / feature-checkout rule as Dockerfile).
# RUST_DOCKER_TAG must be the alpine library/rust label (stable → alpine).
ARG RUST_DOCKER_TAG=alpine
FROM rust:${RUST_DOCKER_TAG}

RUN apk add --no-cache bash ca-certificates musl-dev gcompat

WORKDIR /app

COPY rust-toolchain.toml ./
COPY Cargo.toml ./
COPY buf_lint.rs protoc_with_buf_plugins.rs ./
COPY proto ./proto/

RUN cargo fetch

COPY entrypoint.sh ./
RUN chmod +x entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]
